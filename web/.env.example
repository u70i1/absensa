# Copy this file to .env and adjust if needed.

# The database lives in Docker. See: docker-compose.yml
# Change the port based on db's HOST_PORT (usually the first digits)
DATABASE_URL="postgresql+psycopg2://attendance:attendance@localhost:5433/attendance"

# This one is for testing; So use a separate database
TEST_DATABASE_URL="postgresql+psycopg2://attendance:attendance@localhost:5433/test_attendance"

# The integrated web app is normally same-origin; set this only for an approved external client.
CORS_ORIGIN=http://localhost:8000

PHOTOS_DIR=photos

# Set this to true when Absensa is served over HTTPS in production.
ADMIN_COOKIE_SECURE=false
ACCESS_COOKIE_SECURE=false
ADMIN_SESSION_HOURS=12

# Use the same random token as services/whatsapp/.env. Keep the bridge on localhost.
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_BRIDGE_TOKEN=replace-with-the-same-random-token-as-bridge-env

# Timezone name;
# You can check out other timezone names here: https://gist.github.com/heyalexej/8bf688fd67d7199be4a1682b3eec7568
TIMEZONE="Asia/Jakarta"

# Backups: run python -m app.jobs.backups in a separate process with PostgreSQL 18 pg_dump.
# Generate once: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Save the key separately for disaster recovery; an empty key disables backup creation.
BACKUPS_DIR=backups
BACKUP_ENCRYPTION_KEY=
BACKUP_TIMES=10:00,17:00
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=3
BACKUP_TIMEOUT_SECONDS=3600
