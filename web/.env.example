# Copy this file to .env and adjust if needed.

# The database lives in Docker. See: docker-compose.yml
# Change the port based on db's HOST_PORT (usually the first digits)
DATABASE_URL="postgresql+psycopg2://attendance:attendance@localhost:5433/attendance"

# This one is for testing; So use a separate database
TEST_DATABASE_URL="postgresql+psycopg2://attendance:attendance@localhost:5433/test_attendance"

# The integrated web app is normally same-origin; set this only for an approved external client.
CORS_ORIGIN=http://localhost:8000

PHOTOS_DIR=photos

# Set this to true when Absensa is served over HTTPS in production.
ADMIN_COOKIE_SECURE=false
ACCESS_COOKIE_SECURE=false
ADMIN_SESSION_HOURS=12

# Timezone name;
# You can check out other timezone names here: https://gist.github.com/heyalexej/8bf688fd67d7199be4a1682b3eec7568
TIMEZONE="Asia/Jakarta"
