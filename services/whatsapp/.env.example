# Bind to localhost; FastAPI is the only caller.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3001
# Generate a shared secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_API_TOKEN=replace-with-the-same-random-token-as-web-env

# LocalAuth keeps the WhatsApp Web session here. Back it up if needed.
WHATSAPP_AUTH_DIR=.wwebjs_auth
# Path to the system Chromium used by this bridge.
CHROME_PATH=/usr/bin/chromium
# Set true only if Chromium must run without its sandbox (for example as root).
CHROME_NO_SANDBOX=false
